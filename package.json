{
  "name": "irl-impostor",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "smoke": "node scripts/smoke-test.mjs",
    "test:pacing": "node scripts/pacing-test.mjs",
    "test:proximity": "node scripts/proximity-test.mjs",
    "test:roles": "node scripts/roles-test.mjs",
    "test:hostcontrols": "node scripts/hostcontrols-test.mjs",
    "test:photoproof": "node scripts/photoproof-test.mjs",
    "test:audio": "node scripts/audio-test.mjs",
    "test:abuse": "node scripts/abuse-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "lint": "npm run lint --workspace=client",
    "test:features": "node scripts/features-test.mjs",
    "test:persistence": "node scripts/persistence-test.mjs"
  }
}
